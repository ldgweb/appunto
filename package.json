{
  "name": "appunto",
  "private": true,
  "version": "0.1.0",
  "description": "A tiny blackboard for quick notes and sketches, one shortcut away. It saves while you type.",
  "author": "Lucio (ldgweb)",
  "license": "MIT",
  "homepage": "https://github.com/ldgweb/appunto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldgweb/appunto.git"
  },
  "bugs": {
    "url": "https://github.com/ldgweb/appunto/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "audit:rust": "node scripts/audit-rust.mjs",
    "check:version": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
